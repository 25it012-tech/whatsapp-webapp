# Copy to .env.local and fill locally. Never commit real credentials.
# Public Supabase project URL and anon/publishable key are browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional HTTPS endpoint you control that validates a Supabase bearer token
# and returns {"iceServers":[{"urls":"turn:YOUR_HOST:3478","username":"SHORT_LIVED_USER","credential":"SHORT_LIVED_PASSWORD"}]}.
# Prefer a same-origin endpoint; cross-origin endpoints must explicitly allow
# your app's Origin and Authorization header. Only set an endpoint you trust:
# the user's Supabase access token is sent to it.
# Without this, STUN-only calls may fail across networks.
NEXT_PUBLIC_TURN_CREDENTIALS_ENDPOINT=

# NEVER put a Supabase service_role key or TURN provider master secret here.
